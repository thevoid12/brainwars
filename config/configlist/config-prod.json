{
  "logger": {
    "filepath": "brainwars.logs",
    "level": "debug"
  },
  "app": {
    "type": "production",
    "port": "3000",
    "uiTemplates": "web/ui/templates/",
    "env":".env.production",
    "cookieStoreTimeout": 1200
  },
  "ws": {
    "maxReadSize": 4068,
    "checkOrigin":"https://brainwars.thisisvoid.in" 
  },
  "game": {
    "gamestartbuffer": 3,
    "maxRetryCount":10,
    "waitRetrySecond":5,
    "maxUserInRoom":10
  },
  "cacheCleaner":{
    "intervalMinutes":10 ,
    "repeatIntervalMinutes":5
  },
  "rl":{
    "maxGamesAllowed":3
  }
}