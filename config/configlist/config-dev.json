{
  "logger": {
    "filepath": "brainwars.logs",
    "level": "debug"
  },
  "app": {
    "type": "dev",
    "port": "8080",
    "uiTemplates": "web/ui/templates/",
    "env":".env",
    "cookieStoreTimeout": 1200
  },
  "ws": {
    "maxReadSize": 4068,
    "checkOrigin": "http://localhost:8080" 
  },
  "game": {
    "gamestartbuffer": 3,
    "maxRetryCount":5,
    "waitRetrySecond":3,
    "maxUserInRoom":10
  },
  "cacheCleaner":{
    "intervalMinutes":10 ,
    "repeatIntervalMinutes":5
  },
  "rl":{
    "maxGamesAllowed":3
  },
    "llm":{
     "model":"gemini-2.0-flash-lite",
        "maxRetryCount":10,
        "waitRetrySecond":3 
  }
}